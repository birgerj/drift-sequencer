{
  "name": "Drift — generative MIDI sequencer",
  "short_name": "Drift",
  "description": "Evolving, in-key patterns for your synths and drum machines over USB MIDI.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
