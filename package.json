{
  "name": "drift-sequencer",
  "version": "0.1.0",
  "private": true,
  "description": "Generative browser-based MIDI sequencer (Web MIDI SPA).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "tsc --noEmit && node scripts/build-standalone.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "preact": "^11.1.1",
    "tone": "^15.1.22"
  }
}
